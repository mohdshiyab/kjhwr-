# WindLens Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Elexon BMRS API Endpoints (Public - No API key required)
ELEXON_API_BASE=https://data.elexon.co.uk/bmrs/api/v1/datasets

# Default Market Decision Cutoff Time
